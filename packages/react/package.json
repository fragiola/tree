{
    "name": "@fragiola/tree-react",
    "version": "0.0.0",
    "description": "Composable, headless React primitives and hooks for @fragiola/tree: an accessible tree view you assemble and style yourself.",
    "keywords": [
        "react",
        "tree",
        "treeview",
        "tree-view",
        "headless",
        "accessibility",
        "aria",
        "drag-and-drop"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/tree.git",
        "directory": "packages/react"
    },
    "homepage": "https://fragiola.com/tree",
    "bugs": {
        "url": "https://github.com/fragiola/tree/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./selection": {
            "@fragiola/source": "./src/selection/index.ts",
            "types": "./dist/selection.d.ts",
            "import": "./dist/selection.js",
            "default": "./dist/selection.js"
        },
        "./virtualization": {
            "@fragiola/source": "./src/virtualization/index.ts",
            "types": "./dist/virtualization.d.ts",
            "import": "./dist/virtualization.js",
            "default": "./dist/virtualization.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./selection": {
                "types": "./dist/selection.d.ts",
                "import": "./dist/selection.js",
                "default": "./dist/selection.js"
            },
            "./virtualization": {
                "types": "./dist/virtualization.d.ts",
                "import": "./dist/virtualization.js",
                "default": "./dist/virtualization.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@fragiola/tree": "workspace:*"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "jsdom": "30.1.1",
        "react": "19.2.9",
        "react-dom": "19.2.9",
        "tsdown": "0.23.0",
        "typescript": "7.0.2",
        "vite": "8.3.0",
        "vitest": "5.0.2"
    }
}
