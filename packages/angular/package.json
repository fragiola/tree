{
    "name": "@fragiola/tree-angular",
    "version": "0.1.1",
    "description": "Composable, headless Angular directives and injection functions for @fragiola/tree: an accessible tree view you assemble and style yourself.",
    "keywords": [
        "angular",
        "tree",
        "treeview",
        "tree-view",
        "headless",
        "accessibility",
        "aria",
        "drag-and-drop"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/tree.git",
        "directory": "packages/angular"
    },
    "homepage": "https://fragiola.com/tree",
    "bugs": {
        "url": "https://github.com/fragiola/tree/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular.mjs"
        },
        "./selection": {
            "@fragiola/source": "./selection/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular-selection.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular-selection.mjs"
        },
        "./checkboxes": {
            "@fragiola/source": "./checkboxes/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular-checkboxes.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular-checkboxes.mjs"
        },
        "./rename": {
            "@fragiola/source": "./rename/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular-rename.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular-rename.mjs"
        },
        "./async-children": {
            "@fragiola/source": "./async-children/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular-async-children.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular-async-children.mjs"
        },
        "./type-ahead": {
            "@fragiola/source": "./type-ahead/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular-type-ahead.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular-type-ahead.mjs"
        },
        "./virtualization": {
            "@fragiola/source": "./virtualization/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular-virtualization.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular-virtualization.mjs"
        },
        "./drag-and-drop": {
            "@fragiola/source": "./drag-and-drop/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular-drag-and-drop.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular-drag-and-drop.mjs"
        },
        "./drag-group": {
            "@fragiola/source": "./drag-group/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular-drag-group.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular-drag-group.mjs"
        },
        "./foreign-drop": {
            "@fragiola/source": "./foreign-drop/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular-foreign-drop.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular-foreign-drop.mjs"
        },
        "./drop-outside": {
            "@fragiola/source": "./drop-outside/public-api.ts",
            "types": "./dist/types/fragiola-tree-angular-drop-outside.d.ts",
            "default": "./dist/fesm2022/fragiola-tree-angular-drop-outside.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "directory": "dist",
        "linkDirectory": false
    },
    "scripts": {
        "build": "ng-packagr -p ng-package.json -c tsconfig.build.json && node scripts/publish-manifest.ts",
        "typecheck": "ngc -p tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@fragiola/tree": "workspace:*"
    },
    "peerDependencies": {
        "@angular/core": "^22.0.0"
    },
    "devDependencies": {
        "@analogjs/vite-plugin-angular": "2.9.6",
        "@analogjs/vitest-angular": "2.9.6",
        "@angular/build": "22.2.6",
        "@angular/common": "22.2.5",
        "@angular/compiler": "22.2.5",
        "@angular/compiler-cli": "22.2.5",
        "@angular/core": "22.2.5",
        "@angular/platform-browser": "22.2.5",
        "@fragiola/tree-react": "workspace:*",
        "@testing-library/jest-dom": "7.0.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "jsdom": "30.1.1",
        "ng-packagr": "22.2.6",
        "react": "19.2.9",
        "react-dom": "19.2.9",
        "rxjs": "7.8.2",
        "typescript": "6.0.3",
        "vite": "8.3.0",
        "vitest": "5.0.2"
    }
}
