{
    "name": "@fragiola/tree",
    "version": "0.0.0",
    "description": "Headless, accessible tree view: a typed state model with a command bus, the WAI-ARIA keyboard model, drag and drop, async children, rename and tri-state checkboxes.",
    "keywords": [
        "tree",
        "treeview",
        "tree-view",
        "headless",
        "accessibility",
        "aria",
        "drag-and-drop",
        "checkbox"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/tree.git",
        "directory": "packages/core"
    },
    "homepage": "https://fragiola.com/tree",
    "bugs": {
        "url": "https://github.com/fragiola/tree/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./selection": {
            "@fragiola/source": "./src/selection/index.ts",
            "types": "./dist/selection.d.ts",
            "import": "./dist/selection.js",
            "default": "./dist/selection.js"
        },
        "./virtualization": {
            "@fragiola/source": "./src/virtual/index.ts",
            "types": "./dist/virtualization.d.ts",
            "import": "./dist/virtualization.js",
            "default": "./dist/virtualization.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./selection": {
                "types": "./dist/selection.d.ts",
                "import": "./dist/selection.js",
                "default": "./dist/selection.js"
            },
            "./virtualization": {
                "types": "./dist/virtualization.d.ts",
                "import": "./dist/virtualization.js",
                "default": "./dist/virtualization.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "generate:commands": "tsdown && node scripts/generate-command-docs.ts"
    },
    "devDependencies": {
        "@types/node": "24.13.5",
        "jsdom": "30.1.1",
        "tsdown": "0.23.0",
        "typescript": "7.0.2",
        "vite": "8.3.0",
        "vitest": "5.0.2"
    }
}
